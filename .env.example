DATABASE_URL=sqlite:///./mma.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COOKIE_SECURE=false
APP_ENV=development
PUBLIC_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SESSION_HOURS=24
API_PER_MINUTE=600
AUTH_PER_MINUTE=10
AI_PER_DAY=20
MAX_BODY_BYTES=131072
CONVERSATION_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Optional operator-supplied licensed fighter export (no provider/license bundled)
FIGHTER_LICENSED_EXPORT=
FIGHTER_LICENSE_REFERENCE=

IDENTITY_MODE=local
ALLOW_LEGACY_RECOVERY=true
RETENTION_ENABLED=false
AI_GLOBAL_DAILY=1000
AI_GLOBAL_MONTHLY=10000
AI_ALLOWED_MODELS=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1100
AI_MAX_CONTEXT_CHARS=16000
# Optional operator rate estimates for the monitoring report only (not current pricing).
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0

# Managed sign-in (IDENTITY_MODE=oidc) requires all of the following; see docs/DEPLOYMENT.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Private random value of at least 32 characters, shared by all workers.
OIDC_STATE_SECRET=
# Production release gates; leave false until the documented reviews are complete.
IDENTITY_CUTOVER_ACKNOWLEDGED=false
FIGHTER_DISTRIBUTION_REVIEWED=false

# Shared fighter-data refresh over HTTP by any signed-in account. Unset: development only.
# Never allowed in production; operators run: python -m app.fighter_refresh (from backend/).
ALLOW_USER_FIGHTER_REFRESH=
