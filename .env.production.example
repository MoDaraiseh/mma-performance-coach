# Example only: replace host and database credentials, restrict file permissions.
APP_ENV=production
PUBLIC_ORIGIN=https://mma.example.com
ALLOWED_HOSTS=mma.example.com
COOKIE_SECURE=true
DATABASE_URL=postgresql+psycopg://mma_app:REPLACE@127.0.0.1:5432/mma
SESSION_HOURS=24
API_PER_MINUTE=600
AUTH_PER_MINUTE=10
AI_PER_DAY=20
MAX_BODY_BYTES=131072
CONVERSATION_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=30
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIGHTER_LICENSED_EXPORT=
FIGHTER_LICENSE_REFERENCE=

# Managed identity is mandatory in production. Configure a trusted OIDC provider.
IDENTITY_MODE=oidc
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Generate a private random value (at least 32 characters), shared by all workers.
OIDC_STATE_SECRET=
# Keep existing recovery credentials usable during an explicitly managed migration.
# This bypasses IdP MFA; disable only after users have explicitly linked their accounts.
ALLOW_LEGACY_RECOVERY=true
AI_GLOBAL_DAILY=1000
AI_GLOBAL_MONTHLY=10000
AI_ALLOWED_MODELS=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1100
AI_MAX_CONTEXT_CHARS=16000
# Optional operator-supplied rates: illustrative estimates only, not current pricing.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
# Disabled: installing a dry-run timer never authorizes destructive retention.
RETENTION_ENABLED=false
