# Operator template. Supply real domain/certificates; validate with nginx -t.
# Place this server block in an established HTTPS nginx deployment.
server {
    listen 443 ssl;
    server_name mma.example.invalid;
    ssl_certificate /run/secrets/mma-fullchain.pem;
    ssl_certificate_key /run/secrets/mma-privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    access_log off;
    # Prevent ordinary error logs from recording callback codes/query strings.
    error_log /var/log/nginx/mma-error.log crit;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Replace, do not append untrusted incoming forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 20s;
    }
}
