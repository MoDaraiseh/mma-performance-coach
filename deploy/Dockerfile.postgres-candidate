# Isolated derivative of pinned official PostgreSQL; no server or entrypoint patches.
FROM postgres@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5 AS vendor
RUN apk add --no-cache --upgrade libcurl=8.23.0-r0 brotli-libs=1.2.1-r0 \
    && test "$(id -u postgres)" = 70 && rm /usr/local/bin/gosu
# Copy the merged filesystem so the discarded Go executable is absent from layers too.
FROM scratch
COPY --from=vendor / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=en_US.utf8 PG_MAJOR=18 PG_VERSION=18.6 PGDATA=/var/lib/postgresql/18/docker
LABEL org.opencontainers.image.base.name="docker.io/library/postgres:18-alpine3.24" \
      org.opencontainers.image.base.digest="sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5"
USER 70:70
EXPOSE 5432
STOPSIGNAL SIGINT
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
